# Copy this file to backend/.env and fill in real values. Never commit the real .env.
# .env is already listed in .gitignore.

APP_ENV=development
LOG_LEVEL=info

# Shared bearer token every client must send. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_TOKEN=change-me

# Local Postgres from docker-compose.yml at the repo root.
DATABASE_URL=postgresql+psycopg://aimentum:aimentum@localhost:5432/aimentum

# Anthropic API. Daily calls use the small model, the Sunday retro the larger one.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_DAILY=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_RETRO=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=1024
ANTHROPIC_MAX_RETRIES=2

# Google Cloud Speech-to-Text (voice check-ins). The credentials JSON is the
# full service account key in one env var; it is written to a temp file at
# startup. Comma-separate STT_LANGUAGE_CODES to add languages.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
STT_LANGUAGE_CODES=en-US
