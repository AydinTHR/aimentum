# Copy this file to backend/.env and fill in real values. Never commit the real .env.
# .env is already listed in .gitignore.

APP_ENV=development
LOG_LEVEL=info

# Shared bearer token every client must send. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_TOKEN=change-me

# Hosted Postgres (Neon). Copy the connection string from the Neon dashboard
# and change the scheme to postgresql+psycopg. Prefer the direct endpoint over
# the pooled one (the host without "-pooler"): this is a long-running process
# with its own SQLAlchemy pool, so PgBouncer adds nothing and its transaction
# pooling breaks psycopg's prepared statements.
#   DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DBNAME?sslmode=require
#
# For local Postgres from docker-compose.yml instead:
DATABASE_URL=postgresql+psycopg://aimentum:aimentum@localhost:5432/aimentum

# Shared secret for POST /tick, sent by cron-job.org as the X-Tick-Secret
# header. /tick does not use APP_TOKEN. An unset value rejects every tick.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TICK_SECRET=change-me

# Browser origins allowed to call this API, comma-separated. The Vite dev
# server in development; add the deployed frontend origin in production.
CORS_ORIGINS=http://localhost:5173

# Web push. Generate the key pair once with the command in the README and
# paste both values here. The frontend fetches the public key from
# GET /push/public-key, so it lives only here. VAPID_SUBJECT is the contact
# address push gateways use to reach the sender.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:aidinthr82@gmail.com

# Anthropic API. Daily calls use the small model, the Sunday retro the larger
# one. Leave ANTHROPIC_BASE_URL empty to talk to Anthropic directly.
#
# The same client also works against any gateway that serves the Messages
# API, which is how this runs on an OpenRouter key. Set:
#   ANTHROPIC_BASE_URL=https://openrouter.ai/api
#   ANTHROPIC_API_KEY=<your sk-or-... key>
#   ANTHROPIC_MODEL_DAILY=anthropic/claude-haiku-4.5
#   ANTHROPIC_MODEL_RETRO=anthropic/claude-sonnet-4.6
# Model ids are the provider's, so they change with the base url: OpenRouter
# namespaces and uses dots, Anthropic does not. Clearing the base url without
# also restoring the model ids gets a 404 from the wrong provider.
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL_DAILY=claude-haiku-4-5-20251001
ANTHROPIC_MODEL_RETRO=claude-sonnet-4-6
ANTHROPIC_MAX_TOKENS=1024
ANTHROPIC_MAX_RETRIES=2

# Google Cloud Speech-to-Text (voice check-ins). The credentials JSON is the
# full service account key in one env var; it is written to a temp file on the
# first transcription, not at startup, so a bad value stays invisible until
# the first voice check-in. Comma-separate STT_LANGUAGE_CODES to add languages.
GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS_JSON=
STT_LANGUAGE_CODES=en-US

# Google Calendar. The client id and secret come from a Desktop type OAuth
# client; the refresh token comes from running scripts/google_oauth.py once,
# and the calendar id from scripts/google_calendar_setup.py. Set the OAuth
# consent screen to In production first: in Testing mode Google expires
# refresh tokens after seven days and calendar access dies weekly.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REFRESH_TOKEN=
GCAL_CALENDAR_ID=
